#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
PROJECT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
readonly PROJECT_DIR
readonly IMAGE="localhost/kaon-lab:debian13"
readonly CONTAINER="kaon-lab"
readonly HOME_VOLUME="kaon-lab-home"
readonly STORAGE_ROOT="${KAON_LAB_STORAGE_ROOT:-/var/mnt/Storage/KaonLab/podman}"
readonly -a PODMAN=(podman --root "$STORAGE_ROOT")
readonly LAB_CPUS="${KAON_LAB_CPUS:-8}"
readonly LAB_MEMORY="${KAON_LAB_MEMORY:-10g}"
readonly LAB_MEMORY_SWAP="${KAON_LAB_MEMORY_SWAP:-12g}"

die() {
    printf 'kaon-lab: %s\n' "$*" >&2
    exit 1
}

require_podman() {
    command -v podman >/dev/null || die "Podman is required"
}

image_exists() {
    "${PODMAN[@]}" image exists "$IMAGE"
}

container_exists() {
    "${PODMAN[@]}" container exists "$CONTAINER"
}

build_image() {
    require_podman
    mkdir -p "$STORAGE_ROOT"
    "${PODMAN[@]}" build \
        --tag "$IMAGE" \
        --file "$SCRIPT_DIR/Containerfile" \
        "$SCRIPT_DIR"
}

create_container() {
    require_podman
    container_exists && die "container '$CONTAINER' already exists"
    image_exists || build_image

    mkdir -p "$STORAGE_ROOT"
    "${PODMAN[@]}" volume exists "$HOME_VOLUME" \
        || "${PODMAN[@]}" volume create "$HOME_VOLUME" >/dev/null

    local -a device_args=()
    [[ -e /dev/kvm ]] && device_args+=(--device=/dev/kvm)
    [[ -d /dev/dri ]] && device_args+=(--device=/dev/dri)
    [[ -e /dev/net/tun ]] && device_args+=(--device=/dev/net/tun)

    "${PODMAN[@]}" create \
        --name "$CONTAINER" \
        --hostname "$CONTAINER" \
        --init \
        --userns=keep-id \
        --user developer \
        --workdir /workspace \
        --cpus "$LAB_CPUS" \
        --memory "$LAB_MEMORY" \
        --memory-swap "$LAB_MEMORY_SWAP" \
        --pids-limit 4096 \
        --cap-add SYS_PTRACE \
        --volume "$PROJECT_DIR:/workspace:rw,Z" \
        --volume "$HOME_VOLUME:/home/developer:rw,U" \
        --env TERM="${TERM:-xterm-256color}" \
        --label io.kaon.purpose=development-lab \
        "${device_args[@]}" \
        "$IMAGE" >/dev/null

    printf 'Created %s (%s CPUs, %s RAM).\n' "$CONTAINER" "$LAB_CPUS" "$LAB_MEMORY"
}

start_container() {
    container_exists || create_container
    if [[ "$("${PODMAN[@]}" inspect --format '{{.State.Running}}' "$CONTAINER")" != true ]]; then
        "${PODMAN[@]}" start "$CONTAINER" >/dev/null
    fi
}

exec_in_container() {
    start_container
    local -a terminal_args=(--interactive)
    [[ -t 0 && -t 1 ]] && terminal_args+=(--tty)
    "${PODMAN[@]}" exec \
        "${terminal_args[@]}" \
        --user developer \
        --workdir /workspace \
        "$CONTAINER" "$@"
}

show_status() {
    require_podman
    if ! container_exists; then
        printf '%s\n' "Container: not created"
        image_exists && printf 'Image:     %s\n' "$IMAGE" || printf '%s\n' "Image:     not built"
        return
    fi
    "${PODMAN[@]}" ps --all --filter "name=^${CONTAINER}$" \
        --format 'Container: {{.Names}} ({{.Status}})\nImage:     {{.Image}}'
    printf 'Storage:   %s\n' "$STORAGE_ROOT"
}

destroy_container() {
    require_podman
    container_exists && "${PODMAN[@]}" rm --force "$CONTAINER" >/dev/null
    printf 'Removed container %s; persistent home volume was retained.\n' "$CONTAINER"
}

reset_lab() {
    destroy_container
    if "${PODMAN[@]}" volume exists "$HOME_VOLUME"; then
        "${PODMAN[@]}" volume rm "$HOME_VOLUME" >/dev/null
    fi
    printf 'Removed persistent volume %s. The image was retained.\n' "$HOME_VOLUME"
}

usage() {
    cat <<'EOF'
Usage: .devcontainer/kaon-lab COMMAND [ARG...]

Commands:
  build          Build or rebuild the development image
  create         Create the isolated persistent container
  start          Create if needed, then start the container
  shell          Open an interactive login shell in /workspace
  run CMD [...]  Run a command in /workspace
  stop           Stop the container
  status         Show image and container status
  destroy        Remove the container but retain its home volume
  reset          Remove the container and its persistent home volume

Optional resource overrides:
  KAON_LAB_CPUS=8
  KAON_LAB_MEMORY=10g
  KAON_LAB_MEMORY_SWAP=12g
  KAON_LAB_STORAGE_ROOT=/var/mnt/Storage/KaonLab/podman
EOF
}

main() {
    case "${1:-}" in
        build) build_image ;;
        create) create_container ;;
        start) start_container ;;
        shell) exec_in_container bash --login ;;
        run)
            shift
            (($#)) || die "run requires a command"
            exec_in_container "$@"
            ;;
        stop)
            require_podman
            container_exists && "${PODMAN[@]}" stop "$CONTAINER" >/dev/null
            ;;
        status) show_status ;;
        destroy) destroy_container ;;
        reset) reset_lab ;;
        help|-h|--help|'') usage ;;
        *) die "unknown command '$1' (try: $0 help)" ;;
    esac
}

main "$@"
