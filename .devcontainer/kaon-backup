#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
PROJECT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
readonly PROJECT_DIR
readonly CONTAINER="kaon-lab"
readonly IMAGE="localhost/kaon-lab:debian13"
readonly HOME_VOLUME="kaon-lab-home"
readonly STORAGE_ROOT="${KAON_LAB_STORAGE_ROOT:-/var/mnt/Storage/KaonLab/podman}"
readonly BACKUP_ROOT="${KAON_LAB_BACKUP_ROOT:-${HOME:?}/ChatGPT Temp/Backups}"
readonly -a PODMAN=(podman --root "$STORAGE_ROOT")

die() {
    printf 'kaon-backup: %s\n' "$*" >&2
    exit 1
}

command -v podman >/dev/null || die "Podman is required"
"${PODMAN[@]}" container exists "$CONTAINER" || die "container '$CONTAINER' does not exist"
"${PODMAN[@]}" image exists "$IMAGE" || die "image '$IMAGE' does not exist"

timestamp="$(date '+%Y-%m-%d_%H%M%S')"
readonly timestamp
readonly destination="$BACKUP_ROOT/${timestamp}_kaon-lab"
mkdir -p "$BACKUP_ROOT"
mkdir "$destination"
printf '%s\n' in_progress >"$destination/STATUS"

was_running="$("${PODMAN[@]}" inspect --format '{{.State.Running}}' "$CONTAINER")"
readonly was_running

restart_if_needed() {
    if [[ "$was_running" == true ]]; then
        "${PODMAN[@]}" start "$CONTAINER" >/dev/null
    fi
}
trap restart_if_needed EXIT

if [[ "$was_running" == true ]]; then
    "${PODMAN[@]}" stop "$CONTAINER" >/dev/null
fi

cp -a "$PROJECT_DIR/.devcontainer" "$destination/"
"${PODMAN[@]}" inspect "$CONTAINER" >"$destination/container-inspect.json"
"${PODMAN[@]}" image inspect "$IMAGE" >"$destination/image-inspect.json"
"${PODMAN[@]}" diff "$CONTAINER" >"$destination/container-diff.txt"

if "${PODMAN[@]}" volume exists "$HOME_VOLUME"; then
    "${PODMAN[@]}" volume export --output "$destination/developer-home.tar" "$HOME_VOLUME"
    sha256sum "$destination/developer-home.tar" >"$destination/developer-home.tar.sha256"
fi

cat >"$destination/RESTORE.md" <<'EOF'
# Kaon lab restoration

1. Copy the saved `.devcontainer` directory back into the Kaon project.
2. Run `.devcontainer/kaon-lab build` and `.devcontainer/kaon-lab create`.
3. Stop the container.
4. Import `developer-home.tar` into the `kaon-lab-home` volume with the same
   dedicated Podman storage root.
5. Start the container and verify the files before changing the backup.

The container root filesystem is reproducible from the saved Containerfile.
The archive contains the persistent developer home volume.
EOF

printf '%s\n' complete >"$destination/STATUS"
trap - EXIT
restart_if_needed
printf 'Backup complete: %s\n' "$destination"
