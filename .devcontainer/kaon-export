#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly LAB="$SCRIPT_DIR/kaon-lab"
readonly CONTAINER="kaon-lab"
readonly STORAGE_ROOT="${KAON_LAB_STORAGE_ROOT:-/var/mnt/Storage/KaonLab/podman}"
readonly -a PODMAN=(podman --root "$STORAGE_ROOT")

die() {
    printf 'kaon-export: %s\n' "$*" >&2
    exit 1
}

(($# == 2)) || die "usage: $0 CONTAINER_SOURCE HOST_DESTINATION"
readonly source_path="$1"
readonly destination="$2"
[[ ! -e "$destination" ]] || die "refusing to overwrite: $destination"
[[ -d "$(dirname -- "$destination")" ]] || die "destination directory does not exist"

"$LAB" start
"${PODMAN[@]}" exec --user developer "$CONTAINER" test -e "$source_path" \
    || die "container source does not exist: $source_path"
"${PODMAN[@]}" cp "$CONTAINER:$source_path" "$destination"
printf 'Exported %s to %s\n' "$source_path" "$destination"
