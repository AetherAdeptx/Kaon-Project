{
  "name": "Kaon development lab",
  "build": {
    "dockerfile": "Containerfile",
    "context": "."
  },
  "remoteUser": "developer",
  "containerUser": "developer",
  "runArgs": [
    "--cap-add=SYS_PTRACE"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "13xforever.language-x86-64-assembly",
        "llvm-vs-code-extensions.vscode-clangd"
      ]
    }
  }
}
